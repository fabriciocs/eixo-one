{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "backend/apinode/src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}