# App
APP_ENV=development
PORT=4000

# Firebase project
FIREBASE_PROJECT_ID=eixoone-dev
GOOGLE_CLOUD_PROJECT=eixoone-dev

# Admin SDK
# Prefira usar GOOGLE_APPLICATION_CREDENTIALS em desenvolvimento local.
# Em ambientes controlados, voce pode injetar este JSON por secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
