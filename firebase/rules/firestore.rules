rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasTenant(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }

    function hasPermission(permission) {
      return signedIn()
        && request.auth.token.permissionKeys is list
        && request.auth.token.permissionKeys.hasAny([permission]);
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.roleKeys is list
        && request.auth.token.roleKeys.hasAny(['platform_admin']);
    }

    function canReadFg008(tenantId) {
      return (isPlatformAdmin() || hasTenant(tenantId))
        && hasPermission('base_governance.integrations_api_webhooks.read');
    }

    // FG-008: leitura direta limitada; mutações sensíveis somente pela API Fastify/Admin SDK.
    match /tenants/{tenantId}/integrationApiClients/{clientId} {
      allow read: if canReadFg008(tenantId);
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/webhookSubscriptions/{webhookId} {
      allow read: if canReadFg008(tenantId);
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/integrationEventLogs/{eventId} {
      allow read: if canReadFg008(tenantId);
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/auditLogs/{auditId} {
      allow read: if canReadFg008(tenantId)
        && hasPermission('base_governance.integrations_api_webhooks.history');
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId}/idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
