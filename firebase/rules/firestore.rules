rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasOrg(orgId) {
      return signedIn() && request.auth.token.organizationId == orgId;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin'
      );
    }

    match /organizations/{orgId} {
      allow read: if hasOrg(orgId) || isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if false;
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow delete: if false;
    }

    match /files/{fileId} {
      allow read: if signedIn() && resource.data.organizationId == request.auth.token.organizationId;
      allow write: if false;
    }

    match /integrations/{integrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
