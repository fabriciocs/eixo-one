rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // FG-008: payloads/exportações de integração são sensíveis e devem ser acessados por URLs assinadas geradas no backend.
    match /tenants/{tenantId}/integrations/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
